            <if test="billAmount != null "> and billAmount = #{billAmount}</if>
            <if test="inDiscountPoints != null "> and inDiscountPoints = #{inDiscountPoints}</if>
            <if test="inDiscountAmount != null "> and inDiscountAmount = #{inDiscountAmount}</if>
            <if test="billCategory != null  and billCategory != ''"> and billCategory = #{billCategory}</if>
