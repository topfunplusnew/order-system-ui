    <sql id="selectBankacceptanceVo">
        select id, operateDate, billNo, issueDate, dueDate, billAccount, billDate, billType, reason, billAmount, inDiscountPoints, inDiscountAmount, billCategory, origin, endorser, endorsee, endorseReason, comments, addtime, userId, UserName, update_time, delFlag from bankacceptance
