    <select id="selectBankacceptanceList" parameterType="Bankacceptance" resultMap="BankacceptanceResult">
        <include refid="selectBankacceptanceVo"/>
        <where>  
            <if test="operateDate != null  and operateDate != ''"> and operateDate = #{operateDate}</if>
            <if test="billNo != null  and billNo != ''"> and billNo = #{billNo}</if>
            <if test="issueDate != null  and issueDate != ''"> and issueDate = #{issueDate}</if>
