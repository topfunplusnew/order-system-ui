    <sql id="selectGoodsOrderVo">
        select id,
               ordersNo,
               orderDate,
               customer,
               customerID,
               landCarID,
               landCarNo,
               landDriverTel,
               landDriverName,
               seaCarID,
               seaCarNo,
               seaDriverTel,
               seaDriverName,
               checkUserId,
               checkState,
               invoiceState,
               path,
               PaymentState,
               landBankName,
               landBankNo,
               seaBankName,
               seaBankNo,
               receiveProof,
               saleManager,
               fleet,
               isAdjusted,
               adjustDate,
               isAdjust,
               adjustOrderid,
               isedit,
               customerIsInvoice,
               isSupplierInvoice,
               cancelFlag,
               comments,
               addtime,
               userId,
               UserName,
               update_time
        from goodsOrder
    </sql>

    <select id="selectGoodsOrderList" parameterType="GoodsOrder" resultMap="GoodsOrderResult">
        <include refid="selectGoodsOrderVo"/>
        <where>
<!--            前端传入两个时间戳，在这里做范围匹配-->
            <if test="orderDateStart != null and orderDateStart != '' and orderDateEnd != null and orderDateEnd != ''">
<!--                    需要注意的是时间都是时间戳形式的字符串-->
                and orderDate between #{orderDateStart} and #{orderDateEnd}
            </if>

            <if test="ordersNo != null  and ordersNo != ''">
                and ordersNo = #{ordersNo}
            </if>
            <if test="customer != null  and customer != ''">
                and customer = #{customer}
            </if>
            <if test="customerID != null">
                and customerID = #{customerID}
            </if>
            <if test="landCarID != null">
                and landCarID = #{landCarID}
            </if>
            <if test="landCarNo != null  and landCarNo != ''">
                and landCarNo = #{landCarNo}
            </if>
            <if test="landDriverTel != null  and landDriverTel != ''">
                and landDriverTel = #{landDriverTel}
            </if>
            <if test="landDriverName != null  and landDriverName != ''">
                and landDriverName like concat('%', #{landDriverName}, '%')
            </if>
            <if test="seaCarID != null">
                and seaCarID = #{seaCarID}
            </if>
            <if test="seaCarNo != null  and seaCarNo != ''">
                and seaCarNo = #{seaCarNo}
            </if>
            <if test="seaDriverTel != null  and seaDriverTel != ''">
                and seaDriverTel = #{seaDriverTel}
            </if>
            <if test="seaDriverName != null  and seaDriverName != ''">
