            </if>
            <if test="checkUserId != null">
                and checkUserId = #{checkUserId}
            </if>
            <if test="checkState != null  and checkState != ''">
                and checkState = #{checkState}
            </if>
            <if test="invoiceState != null  and invoiceState != ''">
