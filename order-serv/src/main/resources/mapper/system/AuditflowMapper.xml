<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dzu.system.mapper.AuditflowMapper">
    
    <resultMap type="Auditflow" id="AuditflowResult">
        <result property="id"    column="id"    />
        <result property="flowname"    column="flowname"    />
        <result property="stepnum"    column="stepnum"    />
        <result property="step"    column="step"    />
        <result property="auditauthority"    column="auditauthority"    />
    </resultMap>



    <sql id="selectAuditflowVo">
        select id, flowname, stepnum, step, auditauthority from auditflow
    </sql>

    <select id="selectAuditflowList" parameterType="Auditflow" resultMap="AuditflowResult">
        <include refid="selectAuditflowVo"/>
        <where>
            <if test="flowname != null  and flowname != ''"> and flowname like concat('%', #{flowname}, '%')</if>
            <if test="stepnum != null "> and stepnum = #{stepnum}</if>
            <if test="step != null "> and step = #{step}</if>
            <if test="auditauthority != null  and auditauthority != ''"> and auditauthority = #{auditauthority}</if>
        </where>
        order by step asc
    </select>
    
    <select id="selectAuditflowById" parameterType="Long" resultMap="AuditflowResult">
        <include refid="selectAuditflowVo"/>
        where id = #{id}
    </select>

    <insert id="insertAuditflow" parameterType="Auditflow" useGeneratedKeys="true" keyProperty="id">
        insert into auditflow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="flowname != null">flowname,</if>
            <if test="stepnum != null">stepnum,</if>
            <if test="step != null">step,</if>
            <if test="auditauthority != null">auditauthority,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="flowname != null">#{flowname},</if>
            <if test="stepnum != null">#{stepnum},</if>
            <if test="step != null">#{step},</if>
            <if test="auditauthority != null">#{auditauthority},</if>
         </trim>
    </insert>

    <update id="updateAuditflow" parameterType="Auditflow">
        update auditflow
        <trim prefix="SET" suffixOverrides=",">
            <if test="flowname != null">flowname = #{flowname},</if>
            <if test="stepnum != null">stepnum = #{stepnum},</if>
            <if test="step != null">step = #{step},</if>
            <if test="auditauthority != null">auditauthority = #{auditauthority},</if>
        </trim>
        where id = #{id}
    </update>
    <delete id="deleteAuditflowById" parameterType="Long">
        delete from auditflow where id = #{id}
    </delete>
    <delete id="deleteAuditflowByIds" parameterType="String">
        delete from auditflow where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

   <insert id="insertBatch" parameterType="java.util.List">
    insert into auditflow (flowname, stepnum, step, auditauthority)
    values
    <foreach collection="list" item="item" index="index" separator=",">
        (#{item.flowname}, #{item.stepnum}, #{item.step}, #{item.auditauthority})
    </foreach>
</insert>
</mapper>