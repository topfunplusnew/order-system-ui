# ============================================
# 订单管理系统 Docker Compose 环境变量配置
# ============================================
# 使用方法：
# 1. 复制此文件为 .env: cp env.example .env
# 2. 根据实际环境修改配置值
# 3. 运行: docker-compose up -d
# ============================================

# --------------------------------------------
# 前端服务配置
# --------------------------------------------
# 前端服务端口（正式环境）
FRONTEND_PORT=40085

# 前端服务端口（测试环境）
FRONTEND_PORT_STAGE=40081

# 后端服务端口
BACKEND_PORT=30181

# 后端服务IP地址
# 在 Docker 容器中访问宿主机服务时使用
# - Docker Desktop (Windows/Mac): host.docker.internal
# - Linux: 使用宿主机实际IP或网关IP
# - 同一网络: 使用后端服务容器名或IP
HOST_IP=host.docker.internal

# 前端 Nginx 配置文件路径（宿主机路径）
# 如果不需要挂载自定义配置，可以设置为空或注释掉
FRONTEND_NGINX_CONFIG=./nginx.conf

# 前端日志目录（宿主机路径）
# 日志文件将保存在此目录下
FRONTEND_LOG_DIR=./logs/frontend

# --------------------------------------------
# 请求日志服务配置
# --------------------------------------------
# 日志服务端口
LOGGER_PORT=30010

# 请求日志目录（宿主机路径）
# 日志文件将保存在此目录下，按日期自动创建子目录
LOGGER_LOG_DIR=./logs/request-logger

# 日志保留天数（超过此天数的日志文件会被自动清理）
LOG_MAX_FILES=7

# 日志级别: error, warn, info, verbose, debug, silly
LOG_LEVEL=info

# 是否启用自动清理（true/false）
LOG_CLEANUP_ENABLED=true

# 是否记录成功请求（200状态码）（true/false）
LOG_SUCCESS=true

# --------------------------------------------
# 可选配置
# --------------------------------------------
# 日志文件最大大小（字节），默认 10MB
# LOG_MAX_SIZE=10485760

# 日志清理检查间隔（毫秒），默认 1小时
# LOG_CLEANUP_INTERVAL=3600000

# 日志总大小限制（字节），默认 100MB
# LOG_MAX_TOTAL_SIZE=104857600

# 最少保留的日志文件数量，默认 3
# LOG_MIN_FILES=3

