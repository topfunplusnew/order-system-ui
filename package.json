{
	"name": "order-system-ui",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"description": "订单管理系统 - Monorepo 项目",
	"prettier": "./.prettierrc.js",
	"scripts": {
		"order": "yarn workspace order-system dev",
		"build": "yarn workspace order-system build:stage",
		"build:prod": "yarn workspace order-system build:prod",
		"build:ai": "yarn workspace order-system build:multi",
		"build:ai:prod": "yarn workspace order-system build:multi:prod",
		"build:ai:stage": "yarn workspace order-system build:multi:stage",
		"install-order": "yarn install --ignore-engines",
		"install-logger": "yarn workspace @order-system/request-logger install --ignore-engines",
		"lint": "yarn workspace order-system lint",
		"prettier": "prettier --write \"**/*.{js,vue,json,md,ts,tsx,jsx,css,scss,html}\"",
		"prettier:check": "prettier --check \"**/*.{js,vue,json,md,ts,tsx,jsx,css,scss,html}\"",
		"logger": "yarn workspace @order-system/request-logger start",
		"logger:dev": "yarn workspace @order-system/request-logger dev",
		"scan:table-columns": "node scripts/scan-table-id-addtime-columns.js",
		"scan:table-columns:json": "node scripts/scan-table-id-addtime-columns.js --json"
	},
	"engines": {
		"node": ">=18.20.6"
	},
	"devDependencies": {
		"@babel/core": "^7.15.0",
		"@babel/preset-env": "^7.15.0",
		"@babel/preset-react": "^7.14.5",
		"babel-eslint": "^10.1.0",
		"eslint": "7",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^4.0.0",
		"eslint-plugin-react": "^7.24.0",
		"eslint-plugin-vue": "6",
		"husky": "4.3.8",
		"lint-staged": "10.5.3",
		"prettier": "^2.4.1",
		"script-ext-html-webpack-plugin": "^2.1.5"
	},
	"dependencies": {
		"ant-design-vue": "^1.7.8",
		"dayjs": "^1.11.18",
		"file-saver": "^2.0.5",
		"sockjs-client": "^1.6.1",
		"vue-super-flow": "^1.4.0",
		"vue-tour": "^2.0.0",
		"webstomp-client": "^1.2.6"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"packages/**/*.{js,vue}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{js,json,md}": [
			"prettier --write"
		]
	}
}
